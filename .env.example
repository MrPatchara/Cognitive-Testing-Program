# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Google Apps Script Web App URL (from Deploy > Manage deployments)
WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# CORS origin for GAS (your production domain)
CORS_ORIGIN=https://your-domain.netlify.app

# App version (auto-increment on each release)
APP_VERSION=1.0.0